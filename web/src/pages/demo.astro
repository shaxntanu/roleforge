---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import candidate from '../data/demo/candidate-portfolio.json';
import jobData from '../data/demo/jobs.json';
import outputData from '../data/demo/outputs.json';

const firstJob = jobData.jobs[0];
const firstOutput = outputData.outputs.find((output) => output.jobId === firstJob.id) ?? outputData.outputs[0];
const stages = [
  'Repository discovery',
  'Evidence extraction',
  'Candidate knowledge base',
  'Load job description',
  'Extract requirements',
  'Match portfolio evidence',
  'Analyze fit and gaps',
  'Choose an application strategy',
  'Generate the document',
  'Audit claims against evidence',
  'Package a reviewable snapshot',
];
---

<Layout title="Interactive RoleForge demo" description="Explore one sample portfolio across three target roles and see how RoleForge selects evidence for each application.">
  <SiteNav active="demo" />

  <main class="site-main demo-page">
    <section class="demo-heading container">
      <p class="eyebrow"><span class="pulse-dot"></span> INTERACTIVE WALKTHROUGH</p>
      <h1>One portfolio.<br /><em>Three ways to tell the story.</em></h1>
      <p>Switch the target role, inspect the evidence selected for it, or play the pipeline from repository scan to application snapshot.</p>
    </section>

    <section class="container demo-workspace" aria-label="RoleForge sample application">
      <div class="workspace-bar">
        <div class="workspace-path"><span class="status-light"></span><span>developer-portfolio / roleforge preview</span></div>
        <span class="synthetic-label">SYNTHETIC SAMPLE DATA</span>
      </div>

      <div class="workspace-grid">
        <aside class="portfolio-panel">
          <div class="panel-label"><span>01</span> CANDIDATE SOURCE</div>
          <div class="candidate-card">
            <span class="avatar-mark" aria-hidden="true">{candidate.name.split(' ').map((part) => part[0]).join('')}</span>
            <div><h2>{candidate.name}</h2><p>{candidate.repository}/</p></div>
          </div>
          <div class="portfolio-tree" aria-label="Sample portfolio structure">
            <div><span>▾</span> projects/</div>
            {candidate.projects.slice(0, 4).map((project, index) => (
              <div class="tree-child"><span>{index === 3 ? '└' : '├'}</span> {project.id}/</div>
            ))}
            <div><span>├</span> README.md</div>
            <div><span>└</span> package.json</div>
          </div>
          <div class="portfolio-projects">
            <p class="micro-label">PROJECTS FOUND</p>
            {candidate.projects.slice(0, 3).map((project, index) => (
              <article class="portfolio-project">
                <span class={`project-dot dot-${index + 1}`}></span>
                <div><strong>{project.name}</strong><small>{project.description}</small></div>
              </article>
            ))}
            <p class="more-projects">+ {candidate.projects.length - 3} more projects in sample</p>
          </div>
        </aside>

        <section class="application-panel" data-demo-data={JSON.stringify({ jobs: jobData.jobs, outputs: outputData.outputs })}>
          <div class="panel-label"><span>02</span> JOB-SPECIFIC APPLICATION</div>
          <div class="job-tabs" role="tablist" aria-label="Choose a sample job">
            {jobData.jobs.map((job, index) => (
              <button
                type="button"
                role="tab"
                id={`job-tab-${job.id}`}
                aria-controls="job-detail"
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? '0' : '-1'}
                data-job-tab={job.id}
              >
                <span class="tab-index">0{index + 1}</span>{job.title.replace(' Intern', '')}
              </button>
            ))}
          </div>

          <div class="job-detail" id="job-detail" role="tabpanel" aria-labelledby={`job-tab-${firstJob.id}`}>
            <div class="job-overview">
              <div><p class="micro-label">TARGET POSITION</p><h2 data-job-title>{firstJob.title}</h2><p class="job-company" data-job-company>{firstJob.company} <span>·</span> {firstJob.location}</p></div>
              <span class="job-type" data-job-type>{firstJob.type}</span>
            </div>

            <div class="requirement-heading"><span>REQUIREMENTS FROM THE POSTING</span><span data-requirement-count>{firstJob.requirements.required.length} required</span></div>
            <div class="requirement-list" data-requirement-list>
              {firstJob.requirements.required.slice(0, 4).map((requirement, index) => (
                <div class="requirement-row"><span class="req-index">0{index + 1}</span><span>{requirement.text}</span><i class={index < 2 ? 'req-match' : 'req-review'}>{index < 2 ? 'EVIDENCE' : 'REVIEW'}</i></div>
              ))}
            </div>

            <div class="application-output">
              <div class="output-topline"><span>COMPILED FOR THIS ROLE</span><span class="output-doc-type" data-output-type>{firstOutput.documentType.toUpperCase()} / {firstOutput.template.toUpperCase()}</span></div>
              <div class="output-columns">
                <div><p class="micro-label">SELECTED PROJECTS</p><div class="output-chips" data-selected-projects>{firstOutput.selectedProjects.map((project) => <span>{project}</span>)}</div></div>
                <div><p class="micro-label">EMPHASIZED SKILLS</p><div class="output-chips" data-selected-skills>{firstOutput.selectedSkills.slice(0, 5).map((skill) => <span>{skill}</span>)}</div></div>
              </div>
              <div class="audit-summary"><span class="audit-check">✓</span><strong>Sample audit</strong><span data-audit-copy>{firstOutput.audit.approvedClaims} of {firstOutput.audit.totalClaims} claims supported</span><span class="audit-rate" data-audit-rate>{Math.round(firstOutput.audit.approvalRate * 100)}%</span></div>
              <details class="latex-details"><summary>Peek at the LaTeX output <span aria-hidden="true">＋</span></summary><pre><code data-latex-preview>{firstOutput.latex}</code></pre></details>
            </div>
          </div>
        </section>
      </div>

      <section class="pipeline-player" aria-label="Pipeline playback">
        <div class="player-header">
          <div><p class="micro-label">03 / THE PIPELINE</p><h2 data-stage-title aria-live="polite">Ready when you are.</h2><p data-stage-description>Play the walkthrough to follow this sample application through each stage.</p></div>
          <div class="player-controls">
            <button class="btn btn-primary" type="button" data-run>Run demo <span aria-hidden="true">▶</span></button>
            <button class="btn btn-ghost" type="button" data-pause disabled>Pause</button>
            <button class="reset-button" type="button" data-reset>Reset</button>
          </div>
        </div>
        <div class="progress-track" role="progressbar" aria-label="Demo progress" aria-valuemin="0" aria-valuemax={stages.length} aria-valuenow="0"><span data-progress-fill></span></div>
        <div class="progress-meta"><span data-progress-count>0 / {stages.length} STAGES</span><span data-progress-status>READY</span></div>
        <ol class="stage-list">
          {stages.map((stage, index) => (
            <li data-stage={index} class={index === 0 ? 'stage-step is-current' : 'stage-step'}><span class="stage-number">{String(index + 1).padStart(2, '0')}</span><span class="stage-name">{stage}</span><span class="stage-state" aria-hidden="true">{index === 0 ? '●' : '○'}</span></li>
          ))}
        </ol>
      </section>

      <p class="demo-disclaimer">This demo uses fictional candidate, project, and job data. Its sample audit is illustrative; review your own evidence and generated documents before using them.</p>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .demo-page {
    padding-bottom: var(--section-space);
  }

  .demo-heading {
    padding-top: clamp(3.6rem, 7vw, 6.5rem);
    padding-bottom: 2rem;
  }

  .demo-heading h1 {
    max-width: 900px;
    margin: 0;
    font: 500 clamp(2.8rem, 6vw, 5.35rem)/1 var(--font-display);
    letter-spacing: -0.075em;
    text-wrap: balance;
  }

  .demo-heading h1 em {
    color: var(--accent);
    font: italic 400 0.95em/1 var(--font-serif);
    letter-spacing: -0.045em;
  }

  .demo-heading > p:last-child {
    max-width: 630px;
    margin: 1.3rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .demo-workspace {
    overflow: hidden;
    border: 1px solid var(--line-hi);
    border-radius: 15px;
    background: var(--paper-raised);
    box-shadow: 0 24px 60px rgba(24, 27, 31, 0.1);
  }

  .workspace-bar {
    display: flex;
    min-height: 49px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--line);
    background: rgba(233, 235, 229, 0.48);
  }

  .workspace-path,
  .workspace-path > span:first-child {
    display: flex;
    align-items: center;
  }

  .workspace-path {
    gap: 0.55rem;
    color: var(--muted);
    font: 400 0.59rem var(--font-mono);
  }

  .status-light {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
  }

  .synthetic-label {
    color: var(--dim);
    font: 500 0.51rem var(--font-mono);
    letter-spacing: 0.09em;
  }

  .workspace-grid {
    display: grid;
    grid-template-columns: minmax(240px, 0.72fr) minmax(0, 1.5fr);
    min-height: 600px;
  }

  .portfolio-panel,
  .application-panel {
    min-width: 0;
    padding: clamp(1.1rem, 2.7vw, 2rem);
  }

  .portfolio-panel {
    border-right: 1px solid var(--line);
    background: rgba(233, 235, 229, 0.35);
  }

  .panel-label,
  .micro-label {
    margin: 0;
    color: var(--dim);
    font: 500 0.55rem/1.5 var(--font-mono);
    letter-spacing: 0.12em;
  }

  .panel-label span {
    margin-right: 0.35rem;
    color: var(--accent);
  }

  .candidate-card {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.45rem;
  }

  .avatar-mark {
    display: grid;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper-raised);
    font: 500 0.64rem var(--font-display);
  }

  .candidate-card h2 {
    margin: 0;
    font: 500 0.79rem var(--font-display);
  }

  .candidate-card p {
    margin: 0.15rem 0 0;
    color: var(--muted);
    font: 400 0.55rem var(--font-mono);
  }

  .portfolio-tree {
    display: grid;
    gap: 0.38rem;
    margin: 1.45rem 0 1.5rem;
    padding: 0.9rem;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--paper-raised);
    color: var(--ink-soft);
    font: 400 0.59rem var(--font-mono);
  }

  .portfolio-tree span {
    color: var(--accent);
  }

  .tree-child {
    padding-left: 1rem;
    color: var(--muted);
  }

  .portfolio-projects > .micro-label {
    margin-bottom: 0.55rem;
  }

  .portfolio-project {
    display: grid;
    grid-template-columns: 7px 1fr;
    gap: 0.55rem;
    align-items: start;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
  }

  .project-dot {
    width: 6px;
    height: 6px;
    margin-top: 0.35rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .dot-2 { background: #137960; }
  .dot-3 { background: #6c56a4; }

  .portfolio-project strong,
  .portfolio-project small {
    display: block;
  }

  .portfolio-project strong {
    font: 500 0.65rem var(--font-display);
  }

  .portfolio-project small {
    display: -webkit-box;
    overflow: hidden;
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.55rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .more-projects {
    margin: 0.6rem 0 0;
    color: var(--dim);
    font: 400 0.51rem var(--font-mono);
  }

  .application-panel {
    padding-bottom: 0;
  }

  .job-tabs {
    display: flex;
    gap: 0.3rem;
    overflow-x: auto;
    margin: 1rem -0.25rem 1.25rem;
    padding: 0.25rem;
    border-bottom: 1px solid var(--line);
    scrollbar-width: thin;
  }

  .job-tabs button {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.55rem 0.75rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font: 500 0.62rem var(--font-display);
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .job-tabs button:hover,
  .job-tabs button[aria-selected='true'] {
    border-bottom-color: var(--accent);
    color: var(--ink);
  }

  .tab-index {
    color: var(--accent);
    font: 500 0.51rem var(--font-mono);
  }

  .job-overview {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .job-overview h2 {
    margin: 0.35rem 0 0;
    font: 500 clamp(1rem, 2vw, 1.4rem)/1.25 var(--font-display);
    letter-spacing: -0.04em;
  }

  .job-company {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.64rem;
  }

  .job-company span {
    padding-inline: 0.2rem;
    color: var(--accent);
  }

  .job-type {
    flex-shrink: 0;
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--muted);
    font: 400 0.51rem var(--font-mono);
  }

  .requirement-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 1.4rem 0 0.35rem;
    color: var(--dim);
    font: 500 0.5rem var(--font-mono);
    letter-spacing: 0.08em;
  }

  .requirement-row {
    display: grid;
    grid-template-columns: 27px 1fr auto;
    align-items: center;
    gap: 0.4rem;
    min-height: 37px;
    border-bottom: 1px solid var(--line);
    font-size: 0.62rem;
  }

  .req-index {
    color: var(--dim);
    font: 400 0.52rem var(--font-mono);
  }

  .req-match,
  .req-review {
    color: var(--green);
    font: 500 0.46rem var(--font-mono);
    font-style: normal;
    letter-spacing: 0.04em;
  }

  .req-review {
    color: var(--amber);
  }

  .application-output {
    margin: 1.35rem -1rem 0;
    padding: 1.1rem 1rem 0.9rem;
    border-top: 1px solid var(--line);
    background: rgba(233, 235, 229, 0.38);
  }

  .output-topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--dim);
    font: 500 0.5rem var(--font-mono);
    letter-spacing: 0.08em;
  }

  .output-doc-type {
    color: var(--accent);
  }

  .output-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
    margin-top: 1rem;
  }

  .output-columns .micro-label {
    margin-bottom: 0.4rem;
    font-size: 0.48rem;
  }

  .output-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .output-chips span {
    padding: 0.28rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--paper-raised);
    color: var(--ink-soft);
    font: 400 0.49rem var(--font-mono);
  }

  .audit-summary {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    padding: 0.65rem 0.7rem;
    border: 1px solid rgba(20, 121, 93, 0.18);
    border-radius: 6px;
    background: rgba(20, 121, 93, 0.045);
    color: var(--muted);
    font-size: 0.58rem;
  }

  .audit-check {
    color: var(--green);
    font-weight: 700;
  }

  .audit-summary strong {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .audit-rate {
    margin-left: auto;
    color: var(--green);
    font: 500 0.6rem var(--font-mono);
  }

  .latex-details {
    margin-top: 0.7rem;
  }

  .latex-details summary {
    display: flex;
    justify-content: space-between;
    padding: 0.55rem 0;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.61rem;
    list-style: none;
  }

  .latex-details summary::-webkit-details-marker {
    display: none;
  }

  .latex-details summary span {
    color: var(--accent);
  }

  .latex-details pre {
    max-height: 190px;
    overflow: auto;
    margin: 0 0 0.3rem;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--paper-raised);
    color: var(--ink-soft);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .latex-details code {
    font: 400 0.53rem/1.7 var(--font-mono);
  }

  .pipeline-player {
    padding: clamp(1.1rem, 3vw, 1.8rem);
    border-top: 1px solid var(--line);
    background: var(--paper-raised);
  }

  .player-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .player-header h2 {
    margin: 0.3rem 0 0;
    font: 500 1.05rem var(--font-display);
  }

  .player-header > div:first-child > p:last-child {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.66rem;
  }

  .player-controls {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.4rem;
  }

  .player-controls .btn {
    min-height: 37px;
    padding: 0.5rem 0.8rem;
    font-size: 0.63rem;
  }

  .player-controls .btn span {
    font-size: 0.5rem;
  }

  .player-controls button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    transform: none;
  }

  .reset-button {
    padding: 0.5rem 0.55rem;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.61rem;
  }

  .reset-button:hover {
    color: var(--accent);
  }

  .progress-track {
    height: 3px;
    overflow: hidden;
    margin-top: 1.4rem;
    border-radius: 3px;
    background: var(--paper-deep);
  }

  .progress-track span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--accent);
    transition: width 0.35s var(--ease-out);
  }

  .progress-meta {
    display: flex;
    justify-content: space-between;
    margin-top: 0.45rem;
    color: var(--dim);
    font: 500 0.49rem var(--font-mono);
    letter-spacing: 0.08em;
  }

  .stage-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.35rem;
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .stage-step {
    display: grid;
    grid-template-columns: 24px 1fr 10px;
    align-items: start;
    gap: 0.3rem;
    min-width: 0;
    padding: 0.55rem 0.45rem;
    border: 1px solid transparent;
    border-radius: 5px;
    color: var(--dim);
    font-size: 0.55rem;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .stage-step.is-current {
    border-color: rgba(217, 78, 27, 0.22);
    background: var(--accent-soft);
    color: var(--ink);
  }

  .stage-step.is-done {
    color: var(--green);
  }

  .stage-number {
    color: var(--dim);
    font: 400 0.5rem var(--font-mono);
  }

  .stage-step.is-current .stage-number {
    color: var(--accent);
  }

  .stage-name {
    line-height: 1.4;
  }

  .stage-state {
    color: var(--line-hi);
    font-size: 0.48rem;
  }

  .stage-step.is-current .stage-state {
    color: var(--accent);
  }

  .stage-step.is-done .stage-state {
    color: var(--green);
  }

  .demo-disclaimer {
    margin: 0;
    padding: 0.85rem 1.1rem;
    border-top: 1px solid var(--line);
    color: var(--dim);
    font-size: 0.59rem;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .workspace-grid {
      grid-template-columns: 1fr;
    }

    .portfolio-panel {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .portfolio-tree {
      grid-template-columns: repeat(3, 1fr);
    }

    .stage-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 620px) {
    .demo-heading h1 {
      font-size: clamp(2.5rem, 11vw, 4rem);
    }

    .workspace-bar {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.3rem;
    }

    .portfolio-tree {
      grid-template-columns: repeat(2, 1fr);
    }

    .application-panel {
      padding-bottom: 0;
    }

    .job-overview {
      align-items: flex-start;
      flex-direction: column;
    }

    .output-columns {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .player-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .stage-list {
      grid-template-columns: repeat(2, 1fr);
    }

    .player-controls {
      width: 100%;
    }
  }
</style>

<script>
  const demoPanel = document.querySelector('[data-demo-data]');
  const demoData = JSON.parse(demoPanel?.getAttribute('data-demo-data') || '{"jobs":[],"outputs":[]}');
  const jobTabs = [...document.querySelectorAll('[data-job-tab]')];
  const jobTitle = document.querySelector('[data-job-title]');
  const jobCompany = document.querySelector('[data-job-company]');
  const jobType = document.querySelector('[data-job-type]');
  const jobDetail = document.querySelector('#job-detail');
  const requirementCount = document.querySelector('[data-requirement-count]');
  const requirementList = document.querySelector('[data-requirement-list]');
  const outputType = document.querySelector('[data-output-type]');
  const selectedProjects = document.querySelector('[data-selected-projects]');
  const selectedSkills = document.querySelector('[data-selected-skills]');
  const auditCopy = document.querySelector('[data-audit-copy]');
  const auditRate = document.querySelector('[data-audit-rate]');
  const latexPreview = document.querySelector('[data-latex-preview]');

  const makeChip = (label) => {
    const chip = document.createElement('span');
    chip.textContent = label;
    return chip;
  };

  const renderJob = (jobId, selectedTab) => {
    const job = demoData.jobs.find((item) => item.id === jobId);
    const output = demoData.outputs.find((item) => item.jobId === jobId);
    if (!job || !output) return;

    jobTabs.forEach((tab) => {
      const isSelected = tab === selectedTab;
      tab.setAttribute('aria-selected', String(isSelected));
      tab.setAttribute('tabindex', isSelected ? '0' : '-1');
    });
    jobDetail.setAttribute('aria-labelledby', selectedTab.id);
    jobTitle.textContent = job.title;
    jobCompany.textContent = `${job.company} · ${job.location}`;
    jobType.textContent = job.type;
    requirementCount.textContent = `${job.requirements.required.length} required`;

    const requirements = job.requirements.required.slice(0, 4);
    requirementList.replaceChildren(...requirements.map((requirement, index) => {
      const row = document.createElement('div');
      row.className = 'requirement-row';
      const number = document.createElement('span');
      number.className = 'req-index';
      number.textContent = String(index + 1).padStart(2, '0');
      const text = document.createElement('span');
      text.textContent = requirement.text;
      const status = document.createElement('i');
      const hasEvidence = output.selectedSkills.some((skill) => requirement.text.toLowerCase().includes(skill.toLowerCase()));
      status.className = hasEvidence ? 'req-match' : 'req-review';
      status.textContent = hasEvidence ? 'EVIDENCE' : 'REVIEW';
      row.append(number, text, status);
      return row;
    }));

    outputType.textContent = `${output.documentType.toUpperCase()} / ${output.template.toUpperCase()}`;
    selectedProjects.replaceChildren(...output.selectedProjects.map(makeChip));
    selectedSkills.replaceChildren(...output.selectedSkills.slice(0, 5).map(makeChip));
    auditCopy.textContent = `${output.audit.approvedClaims} of ${output.audit.totalClaims} claims supported`;
    auditRate.textContent = `${Math.round(output.audit.approvalRate * 100)}%`;
    latexPreview.textContent = output.latex;
  };

  jobTabs.forEach((tab) => {
    tab.addEventListener('click', () => renderJob(tab.getAttribute('data-job-tab'), tab));
    tab.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault();
      const direction = event.key === 'ArrowRight' ? 1 : -1;
      const currentIndex = jobTabs.indexOf(tab);
      const nextTab = jobTabs[(currentIndex + direction + jobTabs.length) % jobTabs.length];
      nextTab.focus();
      renderJob(nextTab.getAttribute('data-job-tab'), nextTab);
    });
  });

  const stages = [...document.querySelectorAll('[data-stage]')];
  const runButton = document.querySelector('[data-run]');
  const pauseButton = document.querySelector('[data-pause]');
  const resetButton = document.querySelector('[data-reset]');
  const stageTitle = document.querySelector('[data-stage-title]');
  const stageDescription = document.querySelector('[data-stage-description]');
  const progressFill = document.querySelector('[data-progress-fill]');
  const progressTrack = document.querySelector('[role="progressbar"]');
  const progressCount = document.querySelector('[data-progress-count]');
  const progressStatus = document.querySelector('[data-progress-status]');
  const stageDescriptions = [
    'Read the project tree and identify useful repositories and files.',
    'Collect skills, project details, outcomes, and their source paths.',
    'Build a candidate profile without filling gaps with guesses.',
    'Load the selected job and record where its description came from.',
    'Separate required and preferred qualifications from the posting.',
    'Connect each requirement to evidence or mark it as unsupported.',
    'Summarize strong matches, transferable skills, and missing evidence.',
    'Choose relevant projects, skills, and a document template.',
    'Generate an editable resume or CV from the selected evidence.',
    'Review claims against their recorded support before packaging.',
    'Save the candidate, job, mapping, document, and audit together.',
  ];
  let currentStage = -1;
  let isRunning = false;
  let isPaused = false;
  let timer = null;

  const renderStage = () => {
    stages.forEach((item, index) => {
      item.classList.toggle('is-current', index === currentStage);
      item.classList.toggle('is-done', index < currentStage);
      item.querySelector('.stage-state').textContent = index < currentStage ? '✓' : index === currentStage ? '●' : '○';
    });

    if (currentStage < 0) {
      stageTitle.textContent = 'Ready when you are.';
      stageDescription.textContent = 'Play the walkthrough to follow this sample application through each stage.';
      progressFill.style.width = '0%';
      progressTrack.setAttribute('aria-valuenow', '0');
      progressCount.textContent = `0 / ${stages.length} STAGES`;
      progressStatus.textContent = 'READY';
      return;
    }

    stageTitle.textContent = isRunning ? stages[currentStage].querySelector('.stage-name').textContent : currentStage === stages.length - 1 ? 'Application snapshot ready.' : 'Walkthrough paused.';
    stageDescription.textContent = stageDescriptions[currentStage];
    const completed = currentStage + 1;
    const percentage = Math.round((completed / stages.length) * 100);
    progressFill.style.width = `${percentage}%`;
    progressTrack.setAttribute('aria-valuenow', String(completed));
    progressCount.textContent = `${String(completed).padStart(2, '0')} / ${stages.length} STAGES`;
    progressStatus.textContent = isPaused ? 'PAUSED' : isRunning ? 'IN PROGRESS' : 'COMPLETE';
  };

  const updateControls = () => {
    runButton.disabled = isRunning && !isPaused;
    runButton.innerHTML = isPaused ? 'Resume <span aria-hidden="true">▶</span>' : isRunning ? 'Running…' : currentStage === stages.length - 1 ? 'Run again <span aria-hidden="true">↻</span>' : 'Run demo <span aria-hidden="true">▶</span>';
    pauseButton.disabled = !isRunning || isPaused;
  };

  const scheduleNextStage = () => {
    timer = window.setTimeout(advanceStage, 900);
  };

  const advanceStage = () => {
    if (!isRunning || isPaused) return;
    currentStage += 1;
    renderStage();
    if (currentStage >= stages.length - 1) {
      isRunning = false;
      isPaused = false;
      updateControls();
      renderStage();
      return;
    }
    scheduleNextStage();
  };

  runButton.addEventListener('click', () => {
    if (isRunning && !isPaused) return;
    if (isPaused) {
      isPaused = false;
      isRunning = true;
      updateControls();
      scheduleNextStage();
      renderStage();
      return;
    }
    currentStage = -1;
    isPaused = false;
    isRunning = true;
    updateControls();
    advanceStage();
  });

  pauseButton.addEventListener('click', () => {
    if (!isRunning) return;
    isPaused = true;
    window.clearTimeout(timer);
    updateControls();
    renderStage();
  });

  resetButton.addEventListener('click', () => {
    window.clearTimeout(timer);
    currentStage = -1;
    isRunning = false;
    isPaused = false;
    updateControls();
    renderStage();
  });
</script>
