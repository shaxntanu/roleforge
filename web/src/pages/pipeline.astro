---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pipeline">
  <div class="min-h-screen">
    <div class="grid-bg" aria-hidden="true"></div>

    <!-- Navigation -->
    <nav class="sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--bg-primary)]/80 backdrop-blur-sm">
      <div class="container">
        <div class="flex items-center justify-between py-4">
          <div class="font-display text-2xl font-bold">
            <span class="text-[var(--accent)]">Role</span>Forge
          </div>
          <div class="flex gap-6 text-sm font-mono">
            <a href="/" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">Intro</a>
            <a href="/pipeline" class="text-[var(--accent)]">Pipeline</a>
            <a href="https://github.com/shaxntanu/roleforge" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">GitHub</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Pipeline Hero -->
    <section class="py-20">
      <div class="container">
        <div class="font-mono text-xs text-[var(--text-muted)] mb-4 fade-up">ARCHITECTURE</div>
        <h1 class="font-display text-5xl md:text-6xl font-bold mb-6 fade-up d1">The RoleForge Pipeline</h1>
        <p class="text-xl text-[var(--text-secondary)] max-w-2xl fade-up d2">
          From portfolio evidence to validated, job-specific applications.
        </p>
      </div>
    </section>

    <div class="border-t border-[var(--border)]"></div>

    <!-- Main Pipeline Visualization -->
    <section>
      <div class="container">
        <div class="max-w-6xl mx-auto">
          <div class="p-8 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg fade-up">
            <iframe 
              src="/pipeline-diagram.html" 
              class="w-full h-[800px] border-0 rounded-lg"
              title="RoleForge Pipeline Architecture"
              loading="eager"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <div class="border-t border-[var(--border)]"></div>

    <!-- Evidence Provenance Section -->
    <section>
      <div class="container">
        <div class="font-mono text-xs text-[var(--text-muted)] mb-4 fade-up">EVIDENCE PROVENANCE</div>
        <h2 class="font-display text-4xl font-bold mb-8 fade-up d1">Every claim is traceable</h2>
        <p class="text-xl text-[var(--text-secondary)] mb-12 max-w-2xl fade-up d2">
          Generated resume bullets can be traced back to actual source files in the portfolio.
        </p>
        
        <div class="max-w-3xl mx-auto">
          <div class="p-8 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg fade-up d3">
            <div class="space-y-4 font-mono text-sm">
              <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
                <div class="text-[var(--text-secondary)]">"Built an ESP32-based IoT weather station"</div>
              </div>
              <div class="flex justify-center text-[var(--accent)] text-2xl">↓</div>
              <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
                <div class="text-[var(--accent)]">Zephyr Station project</div>
              </div>
              <div class="flex justify-center text-[var(--accent)] text-2xl">↓</div>
              <div class="grid grid-cols-3 gap-4 text-center">
                <div class="p-3 bg-[var(--bg-tertiary)] rounded text-xs text-[var(--text-secondary)]">README.md</div>
                <div class="p-3 bg-[var(--bg-tertiary)] rounded text-xs text-[var(--text-secondary)]">src/</div>
                <div class="p-3 bg-[var(--bg-tertiary)] rounded text-xs text-[var(--text-secondary)]">metadata</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="border-t border-[var(--border)]"></div>

    <!-- Job Matching Visualization -->
    <section>
      <div class="container">
        <div class="font-mono text-xs text-[var(--text-muted)] mb-4 fade-up">REQUIREMENT MATCHING</div>
        <h2 class="font-display text-4xl font-bold mb-8 fade-up d1">Evidence to requirement mapping</h2>
        
        <div class="max-w-3xl mx-auto">
          <div class="p-8 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg fade-up d2">
            <div class="space-y-6">
              <div class="p-4 bg-[var(--bg-tertiary)] rounded">
                <div class="font-mono text-xs text-[var(--text-muted)] mb-2">JOB REQUIREMENT</div>
                <div class="text-[var(--text-secondary)]">"C++ firmware development"</div>
              </div>
              
              <div class="flex justify-center text-[var(--accent)] text-2xl">↓</div>
              
              <div class="grid grid-cols-3 gap-4">
                <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
                  <div class="font-mono text-xs text-[var(--emerald)] mb-1">✓</div>
                  <div class="text-sm text-[var(--text-secondary)]">C++ evidence</div>
                </div>
                <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
                  <div class="font-mono text-xs text-[var(--emerald)] mb-1">✓</div>
                  <div class="text-sm text-[var(--text-secondary)]">Embedded evidence</div>
                </div>
                <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
                  <div class="font-mono text-xs text-[var(--amber)] mb-1">△</div>
                  <div class="text-sm text-[var(--text-secondary)]">Firmware evidence</div>
                </div>
              </div>
              
              <div class="flex justify-center text-[var(--accent)] text-2xl">↓</div>
              
              <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
                <div class="font-mono text-xs text-[var(--accent)] mb-2">MATCH RESULT</div>
                <div class="text-[var(--accent)] font-semibold">Strong / Partial / Unsupported</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-[var(--border)]">
      <div class="container">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4 py-12">
          <div class="font-display text-xl font-bold">
            <span class="text-[var(--accent)]">Role</span>Forge
          </div>
          <div class="flex gap-6 text-sm font-mono text-[var(--text-secondary)]">
            <a href="https://github.com/shaxntanu/roleforge">GitHub</a>
            <a href="https://github.com/shaxntanu/roleforge/blob/main/LICENSE">MIT License</a>
          </div>
        </div>
      </div>
    </footer>
  </div>
</Layout>
