---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout title="Evidence-backed job applications" description="Turn portfolio evidence into job-specific resumes and CVs. RoleForge maps every claim to its source and keeps you in control.">
  <SiteNav active="home" />

  <main class="site-main">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="pulse-dot"></span> AN OPEN-SOURCE CAREER SKILL</p>
          <h1>Let your portfolio do more of the <em>talking.</em></h1>
          <p class="hero-intro">
            RoleForge traces the work in your repositories, matches it to a job, and shapes the strongest evidence into a resume you can review line by line.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#quickstart">Get started <span aria-hidden="true">↗</span></a>
            <a class="btn btn-ghost" href="/pipeline">Explore the pipeline <span aria-hidden="true">→</span></a>
          </div>
          <div class="install-snippet" aria-label="RoleForge install command">
            <span class="terminal-prompt" aria-hidden="true">$</span>
            <code>npx skills add shaxntanu/roleforge --agent codex --global</code>
            <button type="button" class="copy-command" data-copy-command aria-label="Copy install command">Copy</button>
          </div>
          <p class="copy-feedback" data-copy-feedback aria-live="polite"></p>
          <p class="hero-note">Works from your local portfolio <span>·</span> MIT licensed <span>·</span> You approve every application</p>
        </div>

        <aside class="application-preview" aria-label="Example RoleForge application preview">
          <div class="preview-topbar">
            <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
            <span class="preview-file">APPLICATION / PREVIEW</span>
            <span class="preview-tag">SAMPLE DATA</span>
          </div>
          <div class="preview-content">
            <div class="preview-heading-row">
              <div>
                <p class="micro-label">ROLE TARGET</p>
                <h2 data-preview-title>Embedded Software Engineer</h2>
              </div>
              <span class="fit-mark" aria-label="Evidence found">↗</span>
            </div>

            <div class="role-switch" role="group" aria-label="Choose an example target role">
              <button type="button" data-role-switch="embedded" aria-pressed="true">Embedded</button>
              <button type="button" data-role-switch="frontend" aria-pressed="false">Frontend</button>
              <button type="button" data-role-switch="research" aria-pressed="false">Research</button>
            </div>

            <div class="preview-divider"></div>
            <div class="preview-section-title"><span>01</span> SELECTED PROJECT</div>
            <h3 data-preview-project>AeroSense</h3>
            <p class="preview-description" data-preview-description>ESP32 environmental monitor, supported by firmware and sensor integration evidence.</p>
            <div class="source-line"><span class="source-icon">↳</span><code data-preview-source>README.md · firmware/main.cpp</code></div>
            <div class="tech-list" data-preview-skills aria-label="Relevant evidence">
              <span>C++</span><span>ESP32</span><span>I2C</span><span>Git</span>
            </div>

            <div class="audit-strip">
              <div class="audit-indicator"><span></span><strong>Evidence linked</strong></div>
              <span class="audit-caption">Review before use</span>
            </div>
          </div>
          <div class="preview-footnote"><span>ROLEFORGE / APPLICATION SNAPSHOT</span><span>01 — 03</span></div>
        </aside>

        <div class="hero-rail" aria-label="RoleForge principles">
          <div class="rail-heading">A clearer path from work to application</div>
          <div class="rail-card">
            <span class="rail-number">01</span>
            <div><strong>Your code is the source</strong><small>Projects and files stay traceable</small></div>
          </div>
          <div class="rail-card">
            <span class="rail-number">02</span>
            <div><strong>The job sets the target</strong><small>Requirements stay separate from your facts</small></div>
          </div>
          <div class="rail-card">
            <span class="rail-number">03</span>
            <div><strong>You make the call</strong><small>Review the audit before applying</small></div>
          </div>
        </div>

        <div class="hero-metrics" aria-label="What RoleForge creates">
          <div><b>01</b><span>PORTFOLIO AS SOURCE</span></div>
          <div><b>↔</b><span>EVIDENCE TO REQUIREMENT</span></div>
          <div><b>∞</b><span>ROLE-SPECIFIC VERSIONS</span></div>
          <div><b>✓</b><span>HUMAN REVIEW FIRST</span></div>
        </div>
      </div>
    </section>

    <div class="divider"></div>

    <section class="site-section" id="roles">
      <div class="container">
        <div class="section-header fade-up">
          <p class="section-label">One body of work</p>
          <h2 class="display-heading">Different roles. The evidence stays yours.</h2>
          <p class="section-intro">A portfolio can support more than one story. RoleForge selects the projects and skills that fit each target while keeping every claim anchored to its source.</p>
        </div>

        <div class="role-cards">
          <article class="role-card fade-up d1">
            <div class="role-card-top"><span class="role-index">01 / FIRMWARE</span><span aria-hidden="true">↗</span></div>
            <h3>Embedded systems</h3>
            <p>Bring forward firmware, boards, device protocols, and the files that show how they work.</p>
            <div class="role-evidence"><span>AeroSense</span><span>ForgeBoard</span><span>C / C++</span></div>
          </article>
          <article class="role-card role-card-featured fade-up d2">
            <div class="role-card-top"><span class="role-index">02 / PRODUCT</span><span aria-hidden="true">↗</span></div>
            <h3>Frontend engineering</h3>
            <p>Surface interface work, reusable components, and the stack visible in your projects.</p>
            <div class="role-evidence"><span>InterfaceLab</span><span>PortfolioOS</span><span>React</span></div>
          </article>
          <article class="role-card fade-up d3">
            <div class="role-card-top"><span class="role-index">03 / RESEARCH</span><span aria-hidden="true">↗</span></div>
            <h3>Research &amp; data</h3>
            <p>Give scientific computing and research artifacts room when a role calls for them.</p>
            <div class="role-evidence"><span>MoleculeLab</span><span>Python</span><span>Analysis</span></div>
          </article>
        </div>
        <p class="sample-note">Illustrative examples use synthetic portfolio data.</p>
      </div>
    </section>

    <div class="divider"></div>

    <section class="site-section workflow-section" id="workflow">
      <div class="container">
        <div class="section-header fade-up">
          <p class="section-label">The workflow</p>
          <h2 class="display-heading">A career compiler, in four clear passes.</h2>
          <p class="section-intro">RoleForge treats the portfolio as source material and the job description as a separate target. It shows where the two line up and where they do not.</p>
        </div>

        <div class="workflow-grid">
          <article class="workflow-step fade-up d1">
            <span class="step-marker">01</span>
            <div class="step-rule"></div>
            <h3>Read the portfolio</h3>
            <p>Inspect repository structure, project notes, manifests, and source files for verifiable evidence.</p>
            <span class="step-output">INPUT / REPOSITORY</span>
          </article>
          <article class="workflow-step fade-up d2">
            <span class="step-marker">02</span>
            <div class="step-rule"></div>
            <h3>Map the job</h3>
            <p>Normalize the posting into skills, responsibilities, and requirements with their original source.</p>
            <span class="step-output">INPUT / JOB DESCRIPTION</span>
          </article>
          <article class="workflow-step fade-up d3">
            <span class="step-marker">03</span>
            <div class="step-rule"></div>
            <h3>Shape the story</h3>
            <p>Rank supported projects and skills for the role, then generate editable LaTeX documents.</p>
            <span class="step-output">OUTPUT / RESUME OR CV</span>
          </article>
          <article class="workflow-step fade-up d4">
            <span class="step-marker">04</span>
            <div class="step-rule"></div>
            <h3>Review every claim</h3>
            <p>Inspect the evidence map and truth audit. Keep, revise, or remove anything before you apply.</p>
            <span class="step-output">CONTROL / YOURS</span>
          </article>
        </div>
        <a class="text-link" href="/pipeline">See the complete pipeline <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <div class="divider"></div>

    <section class="site-section artifact-section">
      <div class="container artifact-layout">
        <div class="artifact-copy fade-up">
          <p class="section-label">Traceable by design</p>
          <h2 class="display-heading">A resume you can inspect, not just export.</h2>
          <p class="section-intro">See the requirement, the evidence that supports it, and the gap that remains. RoleForge keeps job criteria out of your candidate facts so a missing skill stays visible.</p>
          <ul class="check-list">
            <li><span>✓</span> Source paths travel with evidence</li>
            <li><span>✓</span> Transferable skills are labeled as transferable</li>
            <li><span>✓</span> Unsupported claims stay out of the draft</li>
          </ul>
          <a class="btn btn-ghost" href="/demo">Walk through a sample <span aria-hidden="true">→</span></a>
        </div>

        <div class="match-board fade-up d2" aria-label="Example requirement and evidence mapping">
          <div class="board-header"><span>REQUIREMENT MAP</span><span>EXAMPLE / SYNTHETIC</span></div>
          <div class="match-row match-job">
            <span class="match-label">JOB REQUIREMENT</span>
            <strong>Embedded C++ development</strong>
            <small>Source: job description</small>
          </div>
          <div class="match-connector"><span></span><span></span><span></span></div>
          <div class="match-row match-evidence">
            <span class="match-label">PORTFOLIO EVIDENCE</span>
            <strong>Weather station firmware</strong>
            <small>README.md · firmware/main.cpp</small>
          </div>
          <div class="match-footer"><span class="match-status"><i></i> DIRECT EVIDENCE</span><span>Trace to source ↗</span></div>
          <div class="board-gap"><span>VISIBLE GAP</span><p>FreeRTOS is requested. No supporting evidence found.</p></div>
        </div>
      </div>
    </section>

    <section class="quickstart-section" id="quickstart">
      <div class="container quickstart-grid">
        <div class="quickstart-copy fade-up">
          <p class="eyebrow"><span class="pulse-dot"></span> QUICK START</p>
          <h2>Install once. Start with your next application.</h2>
          <p>RoleForge is an agent skill. Install it for your coding agent, point it to a portfolio, and provide a job description or URL.</p>
          <a class="btn btn-accent" href="https://github.com/shaxntanu/roleforge" target="_blank" rel="noreferrer">View the source <span aria-hidden="true">↗</span></a>
        </div>

        <div class="quickstart-panel fade-up d2">
          <div class="quickstart-tabs" role="group" aria-label="Choose your agent install command">
            <button type="button" data-agent="codex" aria-pressed="true">Codex</button>
            <button type="button" data-agent="claude-code" aria-pressed="false">Claude Code</button>
            <button type="button" data-agent="cursor" aria-pressed="false">Cursor</button>
          </div>
          <div class="command-label">INSTALL GLOBALLY FOR YOUR AGENT</div>
          <pre><code data-install-command>npx skills add shaxntanu/roleforge --agent codex --global</code></pre>
          <div class="quickstart-hint"><span>THEN ASK</span><p>“Use RoleForge to compare my portfolio with this job and draft an evidence-backed resume.”</p></div>
          <p class="agent-note">Your agent reads local files in your environment. RoleForge does not upload your portfolio.</p>
        </div>
      </div>
    </section>

    <div class="divider"></div>

    <section class="site-section faq-section" id="faq">
      <div class="container faq-layout">
        <div class="section-header fade-up">
          <p class="section-label">A few details</p>
          <h2 class="display-heading">Designed to be useful and honest.</h2>
        </div>
        <div class="faq-list fade-up d2">
          <details>
            <summary>What does RoleForge use as evidence?</summary>
            <p>Repository files, project documentation, manifests, and facts you provide. It records where candidate claims came from and keeps the job description as a separate input.</p>
          </details>
          <details>
            <summary>Does it submit applications for me?</summary>
            <p>No. It prepares documents and reports for your review. You choose what to keep and submit.</p>
          </details>
          <details>
            <summary>What files can I expect?</summary>
            <p>An application snapshot with a candidate profile, normalized job, evidence map, fit analysis, strategy, LaTeX resume, and truth audit. PDF output depends on a LaTeX compiler being available.</p>
          </details>
          <details>
            <summary>Will it fill in missing experience?</summary>
            <p>No. Missing evidence remains a gap. Related skills may be described as transferable, and unsupported claims should be removed or reviewed.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="closing-section">
      <div class="container closing-card fade-up">
        <div>
          <p class="section-label">Make your work legible</p>
          <h2>Your portfolio has the material.<br /><em>RoleForge helps shape it.</em></h2>
        </div>
        <div class="closing-actions">
          <a class="btn btn-primary" href="#quickstart">Install the skill <span aria-hidden="true">↗</span></a>
          <a class="closing-link" href="/demo">See the demo <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .hero {
    position: relative;
    padding: clamp(4rem, 8vw, 7.5rem) 0 3.25rem;
    overflow: hidden;
  }

  .hero::before {
    position: absolute;
    top: -12rem;
    left: 44%;
    width: 54rem;
    height: 34rem;
    pointer-events: none;
    content: '';
    background: radial-gradient(closest-side, rgba(217, 78, 27, 0.08), transparent);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(360px, 5fr);
    gap: 1rem;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    padding: 2.2rem 1.1rem 1rem 0;
  }

  .hero .eyebrow {
    gap: 0.7rem;
    margin-bottom: 1.8rem;
    letter-spacing: 0.16em;
  }

  .hero .eyebrow::before {
    width: 2.3rem;
  }

  .hero h1 {
    max-width: 760px;
    margin: 0;
    font: 500 clamp(3rem, 5.5vw, 5rem) / 1.01 var(--font-display);
    letter-spacing: -0.075em;
    text-wrap: balance;
  }

  .hero h1 em,
  .closing-card h2 em {
    color: var(--accent);
    font: italic 400 1.02em/1 var(--font-serif);
    letter-spacing: -0.045em;
  }

  .hero-intro {
    max-width: 530px;
    margin: 1.5rem 0 1.8rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.8;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .install-snippet {
    display: flex;
    width: fit-content;
    max-width: 100%;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.45rem;
    padding: 0.6rem 0.7rem 0.6rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(252, 252, 249, 0.78);
  }

  .terminal-prompt {
    color: var(--accent);
    font: 600 0.78rem var(--font-mono);
  }

  .install-snippet code {
    overflow: hidden;
    color: var(--ink-soft);
    font: 400 clamp(0.56rem, 1vw, 0.7rem) / 1.4 var(--font-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .copy-command {
    flex-shrink: 0;
    padding: 0.38rem 0.55rem;
    border: 1px solid var(--line-hi);
    border-radius: 5px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font: 500 0.6rem var(--font-mono);
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .copy-command:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .copy-feedback {
    min-height: 0.8rem;
    margin: 0.3rem 0 0;
    color: var(--green);
    font: 500 0.6rem var(--font-mono);
  }

  .hero-note {
    margin: 0.65rem 0 0;
    color: var(--dim);
    font-size: 0.66rem;
  }

  .hero-note span {
    padding-inline: 0.3rem;
    color: var(--accent);
  }

  .application-preview {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-self: stretch;
    overflow: hidden;
    border: 1px solid var(--line-hi);
    border-radius: 15px;
    background: var(--paper-raised);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.75) inset, 0 28px 68px rgba(24, 27, 31, 0.12);
  }

  .preview-topbar,
  .preview-footnote {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    padding: 0.6rem 1.05rem;
    border-bottom: 1px solid var(--line);
  }

  .window-dots {
    display: flex;
    gap: 4px;
  }

  .window-dots span {
    width: 6px;
    height: 6px;
    border: 1px solid var(--line-hi);
    border-radius: 50%;
  }

  .preview-file,
  .preview-tag,
  .preview-footnote,
  .micro-label,
  .preview-section-title,
  .audit-caption {
    color: var(--dim);
    font: 500 0.55rem/1.5 var(--font-mono);
    letter-spacing: 0.12em;
  }

  .preview-tag {
    padding: 0.25rem 0.38rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .preview-content {
    padding: clamp(1.2rem, 3vw, 2rem);
  }

  .preview-heading-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .micro-label {
    margin: 0 0 0.5rem;
    color: var(--accent);
  }

  .preview-heading-row h2 {
    margin: 0;
    font: 500 clamp(1.1rem, 2.2vw, 1.52rem) / 1.2 var(--font-display);
    letter-spacing: -0.045em;
  }

  .fit-mark {
    display: grid;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    place-items: center;
    border: 1px solid rgba(20, 121, 93, 0.22);
    border-radius: 50%;
    background: rgba(20, 121, 93, 0.07);
    color: var(--green);
  }

  .role-switch {
    display: flex;
    gap: 0.35rem;
    margin-top: 1.35rem;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--paper);
  }

  .role-switch button,
  .quickstart-tabs button {
    flex: 1;
    padding: 0.45rem 0.5rem;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font: 500 0.58rem var(--font-mono);
    transition: background 0.18s ease, color 0.18s ease;
  }

  .role-switch button[aria-pressed='true'] {
    background: var(--ink);
    color: white;
  }

  .preview-divider {
    height: 1px;
    margin: 1.4rem 0 1.15rem;
    background: var(--line);
  }

  .preview-section-title {
    display: flex;
    gap: 0.55rem;
    color: var(--muted);
  }

  .preview-section-title span {
    color: var(--accent);
  }

  .preview-content h3 {
    margin: 0.7rem 0 0.3rem;
    font: 500 1.16rem var(--font-serif);
    letter-spacing: -0.015em;
  }

  .preview-description {
    min-height: 3.1rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.65;
  }

  .source-line {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: 0.8rem;
    color: var(--dim);
  }

  .source-icon {
    color: var(--accent);
  }

  .source-line code {
    overflow: hidden;
    font: 400 0.58rem var(--font-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
    margin-top: 1rem;
  }

  .tech-list span,
  .role-evidence span {
    padding: 0.33rem 0.52rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
    font: 500 0.56rem var(--font-mono);
  }

  .audit-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.35rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .audit-indicator {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--green);
    font-size: 0.65rem;
  }

  .audit-indicator span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
  }

  .audit-indicator strong {
    font-weight: 600;
  }

  .audit-caption {
    font-size: 0.51rem;
    letter-spacing: 0.06em;
  }

  .preview-footnote {
    min-height: 36px;
    margin-top: auto;
    border-top: 1px solid var(--line);
    border-bottom: 0;
    font-size: 0.48rem;
  }

  .hero-rail {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
    align-content: start;
    padding-top: 0.65rem;
  }

  .rail-heading {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.1rem;
    color: var(--dim);
    font: 500 0.57rem var(--font-mono);
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .rail-heading::after {
    height: 1px;
    flex: 1;
    background: var(--line);
    content: '';
  }

  .rail-card {
    display: flex;
    min-width: 0;
    gap: 0.65rem;
    padding: 0.8rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: rgba(252, 252, 249, 0.72);
  }

  .rail-number {
    padding-top: 0.12rem;
    color: var(--accent);
    font: 600 0.56rem var(--font-mono);
  }

  .rail-card strong,
  .rail-card small {
    display: block;
  }

  .rail-card strong {
    font: 500 0.66rem/1.4 var(--font-display);
  }

  .rail-card small {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.55rem;
    line-height: 1.45;
  }

  .hero-metrics {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(4, 1fr);
    overflow: hidden;
    margin-top: 0.7rem;
    border: 1px solid var(--line-hi);
    border-radius: 10px;
    background: var(--paper-raised);
  }

  .hero-metrics div {
    min-height: 82px;
    padding: 1rem 1.2rem;
    border-left: 1px solid var(--line);
  }

  .hero-metrics div:first-child {
    border-left: 0;
  }

  .hero-metrics b {
    display: block;
