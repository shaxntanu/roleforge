---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Intro">
  <div class="min-h-screen">
    <!-- Navigation -->
    <nav class="border-b border-[var(--border)]">
      <div class="container">
        <div class="flex items-center justify-between py-4">
          <div class="font-display text-2xl font-bold">
            <span class="text-[var(--accent)]">Role</span>Forge
          </div>
          <div class="flex gap-6 text-sm font-mono">
            <a href="/" class="text-[var(--accent)]">Intro</a>
            <a href="/pipeline">Pipeline</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero -->
    <section class="py-20">
      <div class="container">
        <div class="max-w-3xl">
          <div class="font-mono text-xs text-[var(--accent)] mb-4">
            AGENTIC CAREER COMPILER
          </div>
          <h1 class="font-display text-5xl md:text-6xl font-bold mb-6 leading-tight">
            Compile your portfolio into<br>
            <span class="text-[var(--accent)]">job-specific applications</span>
          </h1>
          <p class="text-xl text-[var(--text-secondary)] mb-8">
            Your code is the source of truth. The job description is the target. 
            RoleForge builds the bridge with evidence-backed resumes, CVs, and opportunity discovery.
          </p>
          <div class="flex gap-4">
            <a href="https://github.com/shaxntanu/roleforge" class="px-6 py-3 bg-[var(--accent)] text-[var(--bg-primary)] font-semibold rounded-lg hover:opacity-90 transition">
              View on GitHub
            </a>
            <a href="/pipeline" class="px-6 py-3 border border-[var(--border)] rounded-lg hover:border-[var(--accent)] transition">
              View Pipeline
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Concept -->
    <section class="py-20 border-t border-[var(--border)]">
      <div class="container">
        <div class="font-mono text-xs text-[var(--text-muted)] mb-4">01</div>
        <h2 class="font-display text-4xl font-bold mb-6">The Core Idea</h2>
        <p class="text-xl text-[var(--text-secondary)] mb-12 max-w-2xl">
          RoleForge behaves like a compiler: it takes source code (your portfolio), 
          parses it into evidence, and generates optimized output (applications) for a target (the job).
        </p>
        
        <div class="grid md:grid-cols-3 gap-6">
          <div class="p-6 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <div class="font-mono text-xs text-[var(--accent)] mb-2">SOURCE</div>
            <h3 class="font-display text-xl font-bold mb-2">Portfolio / Codebase</h3>
            <p class="text-[var(--text-secondary)] text-sm">
              Your GitHub repositories, projects, READMEs, and code are the primary source of truth for your capabilities.
            </p>
          </div>
          
          <div class="p-6 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <div class="font-mono text-xs text-[var(--accent)] mb-2">TARGET</div>
            <h3 class="font-display text-xl font-bold mb-2">Job Description</h3>
            <p class="text-[var(--text-secondary)] text-sm">
              The job posting defines requirements. RoleForge extracts and normalizes them for matching.
            </p>
          </div>
          
          <div class="p-6 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <div class="font-mono text-xs text-[var(--accent)] mb-2">COMPILER</div>
            <h3 class="font-display text-xl font-bold mb-2">RoleForge</h3>
            <p class="text-[var(--text-secondary)] text-sm">
              Maps evidence to requirements, generates tailored documents, and discovers related opportunities.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Principles -->
    <section class="py-20 border-t border-[var(--border)]">
      <div class="container">
        <div class="font-mono text-xs text-[var(--text-muted)] mb-4">02</div>
        <h2 class="font-display text-4xl font-bold mb-6">Principles</h2>
        
        <div class="grid md:grid-cols-2 gap-6">
          <div class="p-6 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <h3 class="font-display text-lg font-bold mb-2 text-[var(--accent)]">Evidence Over Inference</h3>
            <p class="text-sm text-[var(--text-secondary)]">
              Every claim must be backed by verifiable evidence from your portfolio.
            </p>
          </div>
          
          <div class="p-6 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <h3 class="font-display text-lg font-bold mb-2 text-[var(--accent)]">Truth Over Keyword Stuffing</h3>
            <p class="text-sm text-[var(--text-secondary)]">
              Never fabricate skills or experience to match job keywords.
            </p>
          </div>
          
          <div class="p-6 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <h3 class="font-display text-lg font-bold mb-2 text-[var(--accent)]">Source Provenance</h3>
            <p class="text-sm text-[var(--text-secondary)]">
              Every claim includes traceable evidence sources.
            </p>
          </div>
          
          <div class="p-6 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <h3 class="font-display text-lg font-bold mb-2 text-[var(--accent)]">Reusable Resume Families</h3>
            <p class="text-sm text-[var(--text-secondary)]">
              Group similar roles to reduce redundant generation while maintaining relevance.
            </p>
          </div>
          
          <div class="p-6 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <h3 class="font-display text-lg font-bold mb-2 text-[var(--accent)]">Human Approval</h3>
            <p class="text-sm text-[var(--text-secondary)]">
              Applications are prepared for review, not blindly submitted.
            </p>
          </div>
          
          <div class="p-6 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <h3 class="font-display text-lg font-bold mb-2 text-[var(--accent)]">Open Architecture</h3>
            <p class="text-sm text-[var(--text-secondary)]">
              Pluggable job sources, extensible templates, and transparent pipeline.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-12 border-t border-[var(--border)]">
      <div class="container">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
          <div class="font-display text-xl font-bold">
            <span class="text-[var(--accent)]">Role</span>Forge
          </div>
          <div class="flex gap-6 text-sm text-[var(--text-secondary)]">
            <a href="https://github.com/shaxntanu/roleforge">GitHub</a>
            <a href="https://github.com/shaxntanu/roleforge/blob/main/LICENSE">MIT License</a>
          </div>
        </div>
      </div>
    </footer>
  </div>
</Layout>
