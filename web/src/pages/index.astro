<script>
  const roleExamples = {
    embedded: {
      title: 'Embedded Software Engineer',
      project: 'AeroSense',
      description: 'ESP32 environmental monitor, supported by firmware and sensor integration evidence.',
      source: 'README.md · firmware/main.cpp',
      skills: ['C++', 'ESP32', 'I2C', 'Git'],
    },
    frontend: {
      title: 'Frontend Engineer',
      project: 'InterfaceLab',
      description: 'React and TypeScript dashboard, with responsive UI details described in the project README.',
      source: 'README.md · src/components/Dashboard.tsx',
      skills: ['React', 'TypeScript', 'Next.js', 'UI'],
    },
    research: {
      title: 'Computational Researcher',
      project: 'MoleculeLab',
      description: 'Scientific computing project with Python analysis and research workflow evidence.',
      source: 'README.md · src/analysis.py',
      skills: ['Python', 'NumPy', 'SciPy', 'Analysis'],
    },
  };

  const previewTitle = document.querySelector('[data-preview-title]');
  const previewProject = document.querySelector('[data-preview-project]');
  const previewDescription = document.querySelector('[data-preview-description]');
  const previewSource = document.querySelector('[data-preview-source]');
  const previewSkills = document.querySelector('[data-preview-skills]');

  document.querySelectorAll('[data-role-switch]').forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.getAttribute('data-role-switch');
      const example = roleExamples[key];
      if (!example) return;

      document.querySelectorAll('[data-role-switch]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      previewTitle.textContent = example.title;
      previewProject.textContent = example.project;
      previewDescription.textContent = example.description;
      previewSource.textContent = example.source;
      previewSkills.replaceChildren(...example.skills.map((skill) => {
        const chip = document.createElement('span');
        chip.textContent = skill;
        return chip;
      }));
    });
  });

  const codexCommand = 'npx skills add shaxntanu/roleforge --agent codex --global';
  const copyButton = document.querySelector('[data-copy-command]');
  const copyFeedback = document.querySelector('[data-copy-feedback]');
  const installCode = document.querySelector('[data-install-command]');
  const agentCommands = {
    codex: codexCommand,
    'claude-code': 'npx skills add shaxntanu/roleforge --agent claude-code --global',
    cursor: 'npx skills add shaxntanu/roleforge --agent cursor --global',
  };

  document.querySelectorAll('[data-agent]').forEach((button) => {
    button.addEventListener('click', () => {
      const agent = button.getAttribute('data-agent');
      if (!agentCommands[agent]) return;
      document.querySelectorAll('[data-agent]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      installCode.textContent = agentCommands[agent];
    });
  });

  copyButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(codexCommand);
      copyFeedback.textContent = 'Copied to clipboard';
      copyButton.textContent = 'Copied';
    } catch {
      copyFeedback.textContent = 'Select and copy the command above';
    }
  });
</script>
