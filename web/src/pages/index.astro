---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Intro">
  <div class="min-h-screen">
    <div class="grid-bg" aria-hidden="true"></div>

    <!-- Navigation -->
    <nav class="sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--bg-primary)]/80 backdrop-blur-sm">
      <div class="container">
        <div class="flex items-center justify-between py-4">
          <div class="font-display text-2xl font-bold">
            <span class="text-[var(--accent)]">Role</span>Forge
          </div>
          <div class="flex gap-6 text-sm font-mono">
            <a href="/" class="text-[var(--accent)]">Intro</a>
            <a href="/pipeline" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">Pipeline</a>
            <a href="https://github.com/shaxntanu/roleforge" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">GitHub</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero -->
    <section class="py-32">
      <div class="container">
        <div class="max-w-4xl">
          <div class="font-mono text-xs text-[var(--accent)] mb-6 tracking-wider fade-up">
            AGENTIC CAREER COMPILER
          </div>
          <h1 class="font-display text-6xl md:text-7xl font-bold mb-8 leading-tight fade-up d1">
            Compile your portfolio into<br>
            <span class="text-[var(--accent)]">job-specific applications</span>
          </h1>
          <p class="text-xl text-[var(--text-secondary)] mb-12 max-w-2xl leading-relaxed fade-up d2">
            Your code is the source of truth. The job description is the target. 
            RoleForge builds the bridge with evidence-backed resumes, CVs, and opportunity discovery.
          </p>
          <div class="flex gap-4 fade-up d3">
            <a href="/pipeline" class="btn btn-primary">
              Explore the Pipeline
            </a>
            <a href="https://github.com/shaxntanu/roleforge" class="btn btn-ghost">
              View on GitHub
            </a>
          </div>
          
          <!-- Hero Visual -->
          <div class="mt-16 p-8 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg fade-up d4">
            <div class="grid md:grid-cols-4 gap-4 font-mono text-sm text-center">
              <div class="p-4 bg-[var(--bg-tertiary)] rounded">
                <div class="text-[var(--text-secondary)] mb-2">PORTFOLIO</div>
              </div>
              <div class="flex items-center justify-center text-[var(--accent)] text-2xl">↓</div>
              <div class="p-4 bg-[var(--bg-tertiary)] rounded">
                <div class="text-[var(--accent)] mb-2">EVIDENCE</div>
              </div>
              <div class="flex items-center justify-center text-[var(--accent)] text-2xl">↓</div>
            </div>
            <div class="grid md:grid-cols-4 gap-4 font-mono text-sm text-center mt-4">
              <div class="p-4 bg-[var(--bg-tertiary)] rounded">
                <div class="text-[var(--accent)] mb-2">ROLEFORGE</div>
              </div>
              <div class="flex items-center justify-center text-[var(--accent)] text-2xl">↓</div>
              <div class="p-4 bg-[var(--bg-tertiary)] rounded border border-[var(--accent)]">
                <div class="text-[var(--accent)] font-semibold mb-2">APPLICATION</div>
              </div>
              <div></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="border-t border-[var(--border)]"></div>

    <!-- Problem Section -->
    <section>
      <div class="container">
        <div class="font-mono text-xs text-[var(--text-muted)] mb-4 fade-up">THE PROBLEM</div>
        <h2 class="font-display text-4xl font-bold mb-8 fade-up d1">Your career evidence is scattered</h2>
        <p class="text-xl text-[var(--text-secondary)] mb-12 max-w-2xl fade-up d2">
          Developers already have career evidence spread across portfolios, GitHub repositories, source code, README files, and technical documentation. But resumes compress all of that into a static document, and every new job requires manual tailoring.
        </p>
        
        <div class="grid md:grid-cols-2 gap-8 mb-16 fade-up d3">
          <div class="p-8 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <div class="font-mono text-xs text-[var(--text-muted)] mb-4">WITHOUT ROLEFORGE</div>
            <div class="space-y-4 font-mono text-sm">
              <div class="flex items-center gap-3">
                <span class="text-[var(--text-secondary)]">PORTFOLIO</span>
                <span class="text-[var(--accent)]">↓</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-[var(--text-secondary)]">MANUAL REWRITING</span>
                <span class="text-[var(--accent)]">↓</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-[var(--text-secondary)]">RESUME</span>
                <span class="text-[var(--accent)]">↓</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-[var(--text-muted)]">EDIT AGAIN</span>
                <span class="text-[var(--accent)]">↓</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-[var(--text-muted)]">REPEAT</span>
              </div>
            </div>
          </div>
          
          <div class="p-8 bg-[var(--bg-secondary)] border border-[var(--accent)] rounded-lg">
            <div class="font-mono text-xs text-[var(--accent)] mb-4">WITH ROLEFORGE</div>
            <div class="space-y-4 font-mono text-sm">
              <div class="flex items-center gap-3">
                <span class="text-[var(--text-secondary)]">PORTFOLIO</span>
                <span class="text-[var(--accent)]">↓</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-[var(--text-secondary)]">ROLEFORGE</span>
                <span class="text-[var(--accent)]">↓</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-[var(--accent)] font-semibold">JOB-SPECIFIC APPLICATION</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="border-t border-[var(--border)]"></div>

    <!-- Compiler Model -->
    <section>
      <div class="container">
        <div class="font-mono text-xs text-[var(--text-muted)] mb-4 fade-up">THE COMPILER MODEL</div>
        <h2 class="font-display text-4xl font-bold mb-8 fade-up d1">Source → Target → Output</h2>
        
        <div class="grid md:grid-cols-3 gap-6 fade-up d2">
          <div class="p-8 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <div class="font-mono text-xs text-[var(--accent)] mb-4">SOURCE</div>
            <h3 class="font-display text-2xl font-bold mb-4">Portfolio / Codebase</h3>
            <p class="text-[var(--text-secondary)] text-sm leading-relaxed">
              Your GitHub repositories, projects, READMEs, and source code are the primary source of truth for your capabilities.
            </p>
          </div>
          
          <div class="p-8 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <div class="font-mono text-xs text-[var(--accent)] mb-4">TARGET</div>
            <h3 class="font-display text-2xl font-bold mb-4">Job Description</h3>
            <p class="text-[var(--text-secondary)] text-sm leading-relaxed">
              The job posting defines requirements. RoleForge extracts and normalizes them for evidence matching.
            </p>
          </div>
          
          <div class="p-8 bg-[var(--bg-secondary)] border border-[var(--accent)] rounded-lg">
            <div class="font-mono text-xs text-[var(--accent)] mb-4">COMPILER</div>
            <h3 class="font-display text-2xl font-bold mb-4">RoleForge</h3>
            <p class="text-[var(--text-secondary)] text-sm leading-relaxed">
              Maps evidence to requirements, generates tailored documents, and discovers related opportunities.
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="border-t border-[var(--border)]"></div>

    <!-- Source of Truth -->
    <section>
      <div class="container">
        <div class="font-mono text-xs text-[var(--text-muted)] mb-4 fade-up">SOURCE OF TRUTH</div>
        <h2 class="font-display text-4xl font-bold mb-8 fade-up d1">Your work comes first</h2>
        <p class="text-xl text-[var(--text-secondary)] mb-12 max-w-2xl fade-up d2">
          RoleForge derives candidate claims from actual evidence. It never invents experience, skills, or achievements.
        </p>
        
        <div class="grid md:grid-cols-4 gap-6 mb-12 fade-up d3">
          <div class="p-6 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <div class="font-mono text-xs text-[var(--emerald)] mb-2">DIRECT ✓</div>
            <p class="text-sm text-[var(--text-secondary)]">Explicitly present in source material</p>
          </div>
          
          <div class="p-6 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <div class="font-mono text-xs text-[var(--cyan)] mb-2">SUPPORTED ✓</div>
            <p class="text-sm text-[var(--text-secondary)]">Multiple evidence sources</p>
          </div>
          
          <div class="p-6 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <div class="font-mono text-xs text-[var(--amber)] mb-2">INFERRED △</div>
            <p class="text-sm text-[var(--text-secondary)]">Reasonable technical inference</p>
          </div>
          
          <div class="p-6 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg">
            <div class="font-mono text-xs text-[var(--rose)] mb-2">UNSUPPORTED ×</div>
            <p class="text-sm text-[var(--text-secondary)]">No evidence — not generated</p>
          </div>
        </div>
        
        <div class="p-8 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg fade-up d4">
          <div class="font-mono text-sm text-center">
            <div class="text-[var(--text-muted)] mb-4">Unsupported claims</div>
            <div class="text-[var(--accent)] text-2xl mb-4">↓</div>
            <div class="text-[var(--accent)] font-semibold">never silently become resume content</div>
          </div>
        </div>
      </div>
    </section>

    <div class="border-t border-[var(--border)]"></div>

    <!-- One Candidate, Many Roles -->
    <section>
      <div class="container">
        <div class="font-mono text-xs text-[var(--text-muted)] mb-4 fade-up">ROLE-AWARE OUTPUT</div>
        <h2 class="font-display text-4xl font-bold mb-8 fade-up d1">One body of work. Different targets.</h2>
        <p class="text-xl text-[var(--text-secondary)] mb-12 max-w-2xl fade-up d2">
          The same candidate evidence can produce different application artifacts based on the target role.
        </p>
        
        <div class="p-8 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg fade-up d3">
          <div class="font-mono text-sm">
            <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center mb-4">
              <div class="text-[var(--accent)] mb-2">CANDIDATE</div>
              <div class="text-[var(--text-secondary)]">Evidence Base</div>
            </div>
            <div class="grid md:grid-cols-3 gap-4">
              <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
                <div class="text-[var(--accent)] mb-2">Embedded Systems</div>
                <div class="text-[var(--text-muted)] text-xs">↓</div>
                <div class="text-[var(--accent)] mt-2">Embedded Resume</div>
              </div>
              <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
                <div class="text-[var(--accent)] mb-2">Frontend</div>
                <div class="text-[var(--text-muted)] text-xs">↓</div>
                <div class="text-[var(--accent)] mt-2">Frontend Resume</div>
              </div>
              <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
                <div class="text-[var(--accent)] mb-2">Research</div>
                <div class="text-[var(--text-muted)] text-xs">↓</div>
                <div class="text-[var(--accent)] mt-2">Research CV</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="border-t border-[var(--border)]"></div>

    <!-- Opportunity Discovery -->
    <section>
      <div class="container">
        <div class="font-mono text-xs text-[var(--text-muted)] mb-4 fade-up">OPPORTUNITY DISCOVERY</div>
        <h2 class="font-display text-4xl font-bold mb-8 fade-up d1">One role can reveal the next</h2>
        <p class="text-xl text-[var(--text-secondary)] mb-12 max-w-2xl fade-up d2">
          RoleForge discovers adjacent opportunities supported by the same candidate evidence.
        </p>
        
        <div class="p-8 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg mb-8 fade-up d3">
          <div class="grid md:grid-cols-5 gap-4 font-mono text-sm">
            <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
              <div class="text-[var(--accent)] mb-2">TARGET ROLE</div>
            </div>
            <div class="flex items-center justify-center text-[var(--accent)]">→</div>
            <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
              <div class="text-[var(--accent)] mb-2">ROLE FAMILY</div>
            </div>
            <div class="flex items-center justify-center text-[var(--accent)]">→</div>
            <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
              <div class="text-[var(--accent)] mb-2">RELATED</div>
            </div>
          </div>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-5 gap-3 font-mono text-xs fade-up d4">
          <div class="p-3 bg-[var(--bg-tertiary)] rounded text-center text-[var(--text-secondary)]">Embedded Systems</div>
          <div class="p-3 bg-[var(--bg-tertiary)] rounded text-center text-[var(--text-secondary)]">Firmware</div>
          <div class="p-3 bg-[var(--bg-tertiary)] rounded text-center text-[var(--text-secondary)]">IoT</div>
          <div class="p-3 bg-[var(--bg-tertiary)] rounded text-center text-[var(--text-secondary)]">Electronics</div>
          <div class="p-3 bg-[var(--bg-tertiary)] rounded text-center text-[var(--text-secondary)]">Robotics</div>
        </div>
      </div>
    </section>

    <div class="border-t border-[var(--border)]"></div>

    <!-- Job Description Sources -->
    <section>
      <div class="container">
        <div class="font-mono text-xs text-[var(--text-muted)] mb-4 fade-up">JOB INPUT</div>
        <h2 class="font-display text-4xl font-bold mb-8 fade-up d1">The job is the target</h2>
        <p class="text-xl text-[var(--text-secondary)] mb-12 max-w-2xl fade-up d2">
          Candidate truth comes from candidate evidence. Job requirements come from the job description. These must remain separate concepts.
        </p>
        
        <div class="p-8 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg fade-up d3">
          <div class="space-y-4 font-mono text-sm">
            <div class="flex items-center gap-4">
              <div class="p-3 bg-[var(--bg-tertiary)] rounded text-[var(--text-secondary)]">OFFICIAL API</div>
              <div class="text-[var(--accent)]">↓</div>
            </div>
            <div class="flex items-center gap-4">
              <div class="p-3 bg-[var(--bg-tertiary)] rounded text-[var(--text-secondary)]">OFFICIAL COMPANY PAGE</div>
              <div class="text-[var(--accent)]">↓</div>
            </div>
            <div class="flex items-center gap-4">
              <div class="p-3 bg-[var(--bg-tertiary)] rounded text-[var(--text-secondary)]">USER JOB URL</div>
              <div class="text-[var(--accent)]">↓</div>
            </div>
            <div class="flex items-center gap-4">
              <div class="p-3 bg-[var(--bg-tertiary)] rounded text-[var(--text-secondary)]">PERMITTED WEB RETRIEVAL</div>
              <div class="text-[var(--accent)]">↓</div>
            </div>
            <div class="flex items-center gap-4">
              <div class="p-3 bg-[var(--bg-tertiary)] rounded text-[var(--text-secondary)]">USER-PROVIDED JD</div>
              <div class="text-[var(--accent)]">↓</div>
            </div>
            <div class="flex items-center gap-4">
              <div class="p-3 bg-[var(--bg-tertiary)] rounded border border-[var(--accent)] text-[var(--accent)]">VERIFICATION</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="border-t border-[var(--border)]"></div>

    <!-- LaTeX Output -->
    <section>
      <div class="container">
        <div class="font-mono text-xs text-[var(--text-muted)] mb-4 fade-up">APPLICATION OUTPUT</div>
        <h2 class="font-display text-4xl font-bold mb-8 fade-up d1">From evidence to LaTeX</h2>
        
        <div class="p-8 bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg fade-up d2">
          <div class="space-y-4 font-mono text-sm">
            <div class="grid md:grid-cols-2 gap-4">
              <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
                <div class="text-[var(--text-secondary)]">Candidate Evidence</div>
              </div>
              <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
                <div class="text-[var(--text-secondary)]">Job Requirements</div>
              </div>
            </div>
            <div class="flex justify-center text-[var(--accent)] text-2xl">↓</div>
            <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
              <div class="text-[var(--accent)]">Application Strategy</div>
            </div>
            <div class="flex justify-center text-[var(--accent)] text-2xl">↓</div>
            <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center">
              <div class="text-[var(--accent)]">LaTeX</div>
            </div>
            <div class="flex justify-center text-[var(--accent)] text-2xl">↓</div>
            <div class="p-4 bg-[var(--bg-tertiary)] rounded text-center border border-[var(--accent)]">
              <div class="text-[var(--accent)] font-semibold">Resume / CV → PDF</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="border-t border-[var(--border)]"></div>

    <!-- Final CTA -->
    <section>
      <div class="container">
        <div class="max-w-3xl text-center">
          <h2 class="font-display text-5xl font-bold mb-6 fade-up">
            Your portfolio already contains the evidence.
          </h2>
          <h2 class="font-display text-5xl font-bold mb-12 text-[var(--accent)] fade-up d1">
            RoleForge compiles it.
          </h2>
          <div class="flex gap-4 justify-center fade-up d2">
            <a href="/pipeline" class="btn btn-primary">
              Explore the Pipeline
            </a>
            <a href="https://github.com/shaxntanu/roleforge" class="btn btn-ghost">
              View on GitHub
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-[var(--border)]">
      <div class="container">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4 py-12">
          <div class="font-display text-xl font-bold">
            <span class="text-[var(--accent)]">Role</span>Forge
          </div>
          <div class="flex gap-6 text-sm font-mono text-[var(--text-secondary)]">
            <a href="https://github.com/shaxntanu/roleforge">GitHub</a>
            <a href="https://github.com/shaxntanu/roleforge/blob/main/LICENSE">MIT License</a>
          </div>
        </div>
      </div>
    </footer>
  </div>
</Layout>
