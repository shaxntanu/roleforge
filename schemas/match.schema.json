{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/shaxntanu/roleforge/schemas/match.schema.json",
  "title": "Match",
  "description": "Evidence-to-requirement mapping",
  "type": "object",
  "required": ["requirement_id", "evidence_ids", "match_level", "confidence"],
  "properties": {
    "requirement_id": {
      "type": "string",
      "description": "ID of the job requirement"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of supporting evidence"
    },
    "match_level": {
      "type": "string",
      "enum": ["DIRECT_MATCH", "SUPPORTED_MATCH", "TRANSFERABLE_MATCH", "PARTIAL_MATCH", "NO_EVIDENCE", "CONTRADICTED"],
      "description": "How well evidence matches requirement"
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "Confidence in the match assessment"
    },
    "gap_description": {
      "type": "string",
      "description": "Description of any gaps in evidence"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the match"
    }
  }
}
